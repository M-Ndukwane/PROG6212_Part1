name: PROG6212 Part 1 CI

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  validate-project:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check required files
        run: |
          test -f PROG6212.sql
          test -f "API Endpoint.pdf"
          test -f "PROG6212_ERD (1).pdf"

      - name: Check SQL file is not empty
        run: |
          test -s PROG6212.sql

      - name: Validation successful
        run: echo "PROG6212 Part 1 validation passed!"
